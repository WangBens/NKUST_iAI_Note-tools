{
  "name": "nkust-iai-note-tools",
  "productName": "NKUST iAI Note Tools",
  "description": "知音筆記｜高科 iAI 課堂錄音轉學習講義工具",
  "version": "1.0.2",
  "private": true,
  "author": {
    "name": "WangBens",
    "email": "noreply@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "gateway": "node local/ubuntu-gateway.mjs",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types tests/workflow.test.mjs tests/bridge.integration.test.mjs tests/study-notes.test.mjs tests/recovery.test.mjs tests/dedup.integration.test.mjs tests/completeness.test.mjs tests/generic.test.mjs tests/upstream.test.mjs",
    "mock": "node tests/mock-iai-server.mjs",
    "bridge": "node --experimental-strip-types local/iai-bridge.mjs",
    "format": "oxfmt",
    "electron:start": "electron .",
    "electron:dev": "pnpm run build && electron .",
    "electron:build": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "ffmpeg-static": "5.3.0",
    "input-otp": "1.4.2",
    "jsonrepair": "^3.15.0",
    "katex": "^0.19.0",
    "lucide-react": "1.31.0",
    "opencc-js": "^1.4.2",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unified": "^11.0.5",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "build": {
    "appId": "com.wangbens.nkustiainotetools",
    "productName": "NKUST iAI Note Tools",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "local/**/*",
      "lib/**/*",
      "public/**/*",
      "dist/client/**/*",
      "dist/server/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  },
  "type": "module"
}
